rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function myRole(gameId) {
      return gameData(gameId).roles.get(request.auth.uid, '');
    }
    function isParticipant(gameId) {
      return request.auth != null && myRole(gameId) != '';
    }
    function isHunterOnGame(gameId) {
      return request.auth != null && myRole(gameId) == 'hunter';
    }
    function isValidator(gameId) {
      return request.auth != null && myRole(gameId) in ['chicken', 'gameMaster'];
    }
    function derivedGameCode(gameId) {
      return gameId[0:6].upper();
    }
    function knownPowerUpTypes() {
      return ['zonePreview', 'radarPing', 'invisibility', 'zoneFreeze', 'decoy', 'jammer'];
    }
    function hunterPowerUpTypes() {
      return ['zonePreview', 'radarPing'];
    }
    function boundedString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function validGameShape(d, gameId) {
      return boundedString(d.creatorId, 128)
          && boundedString(d.get('name', ''), 60)
          && d.gameMode in ['followTheChicken', 'stayInTheZone']
          && d.maxPlayers is int
          && d.maxPlayers >= 2
          && (d.maxPlayers <= 5
              || (d.get('isAdminCreation', false) == true && d.maxPlayers <= 500))
          && d.zone.radius is number
          && d.zone.radius > 0
          && d.zone.radius <= 50000
          && d.zone.shrinkIntervalMinutes is number
          && d.zone.shrinkIntervalMinutes >= 1
          && d.zone.get('shrinkMetersPerUpdate', 0) is number
          && d.zone.get('driftSeed', 0) is int
          && d.timing.start is timestamp
          && d.timing.end is timestamp
          && d.timing.start < d.timing.end
          && d.timing.headStartMinutes is number
          && d.timing.headStartMinutes >= 0
          && d.timing.headStartMinutes <= 180
          && d.powerUps.get('enabledTypes', []).hasOnly(knownPowerUpTypes())
          && d.get('gameCode', derivedGameCode(gameId)) == derivedGameCode(gameId)
          && (d.get('registrationBatchId', null) == null
              || boundedString(d.registrationBatchId, 64));
    }

    match /games/{gameId} {
      allow get: if request.auth != null;

      // The single-result query by gameCode is what released app versions
      // still use to join; new versions resolve codes through /gameCodes.
      allow list: if request.auth != null
                  && (resource.data.creatorId == request.auth.uid
                      || request.query.limit <= 1);

      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && validGameShape(request.resource.data, gameId)
                    && request.resource.data.roles.keys().hasOnly([request.auth.uid])
                    && request.resource.data.roles.get(request.auth.uid, '') == 'chicken'
                    && request.resource.data.get('winners', []).size() == 0
                    && request.resource.data.get('hasGameMasterPassword', false) == false
                    && request.resource.data.get('foundCode', '') == ''
                    && request.resource.data.timing.get('actualStart', null) == null;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.creatorId
                        || resource.data.roles.get(request.auth.uid, '') == 'chicken')
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status'])
                    && resource.data.status in ['waiting', 'readyToLaunch', 'inProgress']
                    && request.resource.data.status == 'done';

      // Released Android versions write gameCode in a second batched write.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.creatorId
                    && resource.data.status == 'waiting'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['gameCode'])
                    && request.resource.data.gameCode == derivedGameCode(gameId);

      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid
                    && resource.data.status == 'waiting';

      match /private/{docId} {
        allow read, write: if false;
      }

      match /lifecycle/{document=**} {
        allow read, write: if false;
      }

      match /players/{playerId} {
        allow read: if isParticipant(gameId);
        allow write: if false;
      }

      match /challengeCompletions/{hunterId} {
        allow read: if isParticipant(gameId);
        allow write: if false;
      }

      match /aggregates/{docId} {
        allow read: if isParticipant(gameId);
        allow write: if false;
      }

      match /zone/{docId} {
        allow read: if isParticipant(gameId);
        allow write: if false;
      }

      match /challenges/{challengeId} {
        allow read: if isParticipant(gameId);
        allow write: if false;
      }

      match /challengeSubmissions/{submissionId} {
        allow read: if request.auth != null
                    && (resource.data.hunterId == request.auth.uid
                        || isValidator(gameId));
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.hunterId
                      && isHunterOnGame(gameId)
                      && gameData(gameId).status == 'inProgress'
                      && (gameData(gameId).timing.get('end', null) == null
                          || request.time < gameData(gameId).timing.end)
                      && request.resource.data.keys().hasOnly(['challengeId', 'hunterId', 'type', 'submittedAt', 'mediaUrl', 'mediaType', 'status'])
                      && request.resource.data.keys().hasAll(['challengeId', 'hunterId', 'type', 'submittedAt', 'mediaUrl', 'mediaType', 'status'])
                      && request.resource.data.status == 'pending'
                      && request.resource.data.type in ['oneShot', 'repeatable']
                      && request.resource.data.mediaType in ['image', 'video']
                      && request.resource.data.submittedAt is timestamp
                      && boundedString(request.resource.data.challengeId, 128)
                      && request.resource.data.challengeId.size() > 0
                      && boundedString(request.resource.data.mediaUrl, 1024)
                      && request.resource.data.mediaUrl.matches(
                           '^https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/gameSubmissions%2F'
                           + gameId + '%2F' + submissionId + '[.](jpg|mp4)[?].*$');
        allow update, delete: if false;
      }

      // Released app versions collect through this write; new versions go
      // through the collectPowerUp callable, which also checks the distance.
      match /powerUps/{powerUpId} {
        allow read: if isParticipant(gameId);
        allow create, delete: if false;
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['collectedBy', 'collectedAt'])
                      && request.resource.data.collectedBy == request.auth.uid
                      && request.resource.data.collectedAt is timestamp
                      && resource.data.get('collectedBy', null) == null
                      && gameData(gameId).status == 'inProgress'
                      && (
                        (myRole(gameId) == 'hunter'
                          && resource.data.type in hunterPowerUpTypes())
                        || (myRole(gameId) == 'chicken'
                          && !(resource.data.type in hunterPowerUpTypes()))
                      );
      }
    }

    match /gameCodes/{code} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /memberships/{gameId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /challenges/{challengeId} {
      allow read, write: if false;
    }

    match /gmRateLimits/{docId} {
      allow read, write: if false;
    }

    match /validationRateLimits/{uid} {
      allow read, write: if false;
    }

    match /foundCodeRateLimits/{docId} {
      allow read, write: if false;
    }

    match /failedSideEffects/{docId} {
      allow read, write: if false;
    }

    match /accountDeletionRequests/{rid} {
      allow read, write: if false;
    }

    match /eventRegistrations/{registrationId} {
      allow read, create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'reportedNickname', 'gameId', 'createdAt'])
                    && request.resource.data.keys().hasAll(['reporterId', 'reportedUserId', 'reportedNickname', 'gameId', 'createdAt'])
                    && request.resource.data.reporterId == request.auth.uid
                    && boundedString(request.resource.data.reportedUserId, 128)
                    && request.resource.data.reportedUserId.size() > 0
                    && request.resource.data.reportedUserId != request.auth.uid
                    && boundedString(request.resource.data.reportedNickname, 60)
                    && boundedString(request.resource.data.gameId, 128)
                    && request.resource.data.createdAt is timestamp
                    && isParticipant(request.resource.data.gameId);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
