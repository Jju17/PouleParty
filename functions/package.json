{
  "name": "pouleparty-functions",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-pouleparty --only firestore,database,storage \"vitest run --config vitest.rules.config.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test",
    "serve": "npm run build && firebase emulators:start --only functions",
    "gcp-build": "",
    "parity:golden": "tsx scripts/generateParityGolden.ts",
    "lint": "oxlint --deny-warnings",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "googleapis": "185.0.0",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "firebase": "13.0.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "private": true,
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
