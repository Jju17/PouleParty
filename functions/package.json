{
  "name": "pouleparty-functions",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-pouleparty --only firestore,database,storage \"vitest run --config vitest.rules.config.ts\"",
    "verify": "npm run typecheck && npm test",
    "serve": "npm run build && firebase emulators:start --only functions",
    "gcp-build": ""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^171.4.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "private": true
}
