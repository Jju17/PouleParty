rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function gameData(gameId) {
      return firestore.get(/databases/(default)/documents/games/$(gameId)).data;
    }
    function roleOn(gameId) {
      return gameData(gameId).roles.get(request.auth.uid, '');
    }

    match /gameSubmissions/{gameId}/{fileName} {
      // The uploader needs read access to obtain the download URL; other
      // hunters never learn file names since submissions are hidden from them.
      allow read: if request.auth != null && roleOn(gameId) != '';
      allow create: if request.auth != null
                    && roleOn(gameId) == 'hunter'
                    && gameData(gameId).status == 'inProgress'
                    && fileName.matches('^[A-Za-z0-9]{20}[.](jpg|mp4)$')
                    && request.resource.size < 25 * 1024 * 1024
                    && ((fileName.matches('.*[.]jpg$') && request.resource.contentType == 'image/jpeg')
                        || (fileName.matches('.*[.]mp4$') && request.resource.contentType == 'video/mp4'));
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
